# Ubuntu VM IP reachable from your Windows browser; no protocol or port.
VM_HOST=192.168.1.100

POSTGRES_DB=modular_housing_dev
POSTGRES_USER=modular_dev
POSTGRES_PASSWORD=change-this-dev-password
POSTGRES_PORT=5432

# Preserved upstream images via the 1Panel cache; no direct Docker Hub access needed.
MINIO_IMAGE=docker.1panel.live/netiedge/minio:RELEASE.2025-01-20T14-49-07Z
MC_IMAGE=docker.1panel.live/netiedge/minio-mc:RELEASE.2025-01-17T23-25-50Z
MINIO_ROOT_USER=minio-dev
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=modular-housing-dev
S3_REGION=us-east-1

WEB_PORT=3000
CMS_PORT=1337
STRAPI_SERVER_TOKEN=dev-inquiry-secret-change-me
SEED_DEMO_CONTENT=true
# Optional automatic translation on admin publish; only injected into CMS.
# API URL is the full Chat Completions endpoint, not just the base URL.
AUTO_TRANSLATE_ENABLED=false
AUTO_TRANSLATE_API_URL=
AUTO_TRANSLATE_API_KEY=
AUTO_TRANSLATE_MODEL=
AUTO_TRANSLATE_TIMEOUT_MS=30000
TRUST_PROXY=false
# Optional: set both keys together. Use the actual browser hostname (no port/protocol).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=

APP_KEYS=dev-key-one,dev-key-two
ADMIN_JWT_SECRET=dev-admin-jwt-secret-change-me
API_TOKEN_SALT=dev-api-token-salt-change-me
TRANSFER_TOKEN_SALT=dev-transfer-token-salt-change-me
ENCRYPTION_KEY=dev-encryption-key-change-me

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
ADMINER_PORT=8080

