# PostgreSQL
# For host-run apps: direct development requests must not trust client proxy headers.
TRUST_PROXY=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=

# Optional automatic translation for the host-run CMS.
AUTO_TRANSLATE_ENABLED=false
AUTO_TRANSLATE_API_URL=
AUTO_TRANSLATE_API_KEY=
AUTO_TRANSLATE_MODEL=
AUTO_TRANSLATE_TIMEOUT_MS=30000

POSTGRES_DB=modular_housing_dev
POSTGRES_USER=modular_dev
POSTGRES_PASSWORD=change-this-dev-password
POSTGRES_PORT=5432

# Optional local MinIO
# Preserved upstream image via the 1Panel cache for development.
MINIO_IMAGE=docker.1panel.live/netiedge/minio:RELEASE.2025-01-20T14-49-07Z
MINIO_ROOT_USER=minio-dev
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Optional Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Optional Adminer
ADMINER_PORT=8080
