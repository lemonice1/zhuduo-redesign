# Production only. Copy to .env on the Linux host, chmod 600, and fill every blank.
SITE_DOMAIN=
CMS_DOMAIN=
# Absolute directory containing site/{fullchain.pem,privkey.pem} and cms equivalents.
TLS_CERTS_DIR=
RELEASE_TAG=local
POSTGRES_DB=modular_housing
POSTGRES_USER=modular_housing
POSTGRES_PASSWORD=
APP_KEYS=
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
STRAPI_SERVER_TOKEN=
# Optional automatic translation on admin publish; only injected into CMS.
# API URL is the full Chat Completions endpoint, not just the base URL.
AUTO_TRANSLATE_ENABLED=false
AUTO_TRANSLATE_API_URL=
AUTO_TRANSLATE_API_KEY=
AUTO_TRANSLATE_MODEL=
AUTO_TRANSLATE_TIMEOUT_MS=30000
# S3-compatible storage. For self-hosted MinIO, also load docker-compose.minio.yml.
# CMS credentials must differ from MinIO root credentials.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_FORCE_PATH_STYLE=true
S3_ROOT_PATH=
MEDIA_PUBLIC_URL=
# Self-hosted MinIO only: create/chown this directory before starting containers.
MINIO_DATA_DIR=/srv/zhuduo/minio-data
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Both keys empty disables captcha. Configure both together; hostname has no protocol.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
# Host backup script configuration (export separately, never injected into apps).
# rclone remotes must be separately configured; backup target is private and offsite.
BACKUP_LOCAL_DIR=/var/backups/modular-housing
BACKUP_SOURCE=
BACKUP_TARGET=
BACKUP_RELEASE=
BACKUP_CONFIRM_WRITES_PAUSED=
