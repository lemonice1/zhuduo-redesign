{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2020"],
    "target": "ES2020",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmitOnError": true,
    "allowJs": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["config/**/*", "src/**/*", "src/**/*.json"],
  "exclude": ["node_modules", "build", ".cache", "dist", "src/admin", "tests"]
}
