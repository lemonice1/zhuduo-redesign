    "contactEmail": { "type": "email" },
    "footerNote": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "whatsappNumber": { "type": "string" },
    "exhibitionName": { "type": "string" },
    "companyAddress": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "companyIntro": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "exhibitionDetails": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "foundedYear": { "type": "integer", "min": 1800, "max": 2100 },
    "factoryArea": { "type": "decimal", "min": 0 },
    "exportMarkets": { "type": "integer", "min": 0 },
    "certificationCount": { "type": "integer", "min": 0 },
    "factoryImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "heroHousingImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "heroElectricalImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] }
  }
