{
  "kind": "collectionType",
  "collectionName": "certificates",
  "info": { "singularName": "certificate", "pluralName": "certificates", "displayName": "Certificate" },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "slug": { "type": "uid", "targetField": "title", "required": true, "unique": true },
    "title": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "description": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "issuer": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "document": { "type": "media", "multiple": false, "allowedTypes": ["images", "files"] },
    "sortOrder": { "type": "integer", "default": 0 }
  }
}
